# Copy to .env.local and fill in the four Supabase values. `npm run keys` generates the rest.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Session-pooler URI from Supabase > Connect. Used only by `npm run migrate`.
DATABASE_URL=

# Optional. AI features fall back to deterministic logic without it.
ANTHROPIC_API_KEY=

# Generated by `npm run keys`.
ED25519_PRIVATE_KEY_PEM=
ED25519_PUBLIC_KEY_PEM=
HMAC_MATCH_KEY=
FIELD_ENC_KEY=
APP_BASE_URL=http://localhost:3000
DEMO_MODE=true

# Written by `npm run seed` the first time it creates the scholarship portal's API key.
SCHOLARSHIP_PORTAL_API_KEY=

# Address signed into seeded credentials and used by the demo webhook. Defaults to the live demo.
DEMO_PUBLIC_URL=https://sutra.teentechindia.com

# Optional AI. Leave AI_PROVIDER empty for offline mode. Choose ollama (on this machine, no key), gemini, groq or anthropic, and add that provider's key.
AI_PROVIDER=
# Checked 2026-11-02: this lite model answers within the 4-second limit. Set the model that matches your provider.
AI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
GROQ_API_KEY=
# Only for ollama. This is the default address.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Optional. Defaults to 4000 ms, or 15000 ms for ollama, whose first call loads the model.
AI_TIMEOUT_MS=
# Local development only: lets webhooks use http://localhost.
ALLOW_PRIVATE_WEBHOOKS=
